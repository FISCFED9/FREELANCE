# Copia este archivo como .env y rellena tus claves
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows)

# ─── OPCIÓN A: OpenRouter (la que ya tienes configurada) ───────────
# Consigue tu clave en https://openrouter.ai/keys
ANTHROPIC_API_KEY=tu_clave_openrouter_aqui
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1

# ─── OPCIÓN B: Anthropic directo ──────────────────────────────────
# Consigue tu clave en https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-tu_clave_aqui
# (Si usas esta opción, borra o comenta ANTHROPIC_BASE_URL)

# ─── OPCIÓN C: OLLAMA local (modelos locales, sin costo) ──────────
# Requiere OLLAMA corriendo: ollama serve
# Limitación: sin web_search ni thinking avanzado
# ANTHROPIC_BASE_URL=http://localhost:11434/v1
# ANTHROPIC_API_KEY=ollama
